---
import { SOCIAL_LINKS } from '@/consts'

const emailLink = SOCIAL_LINKS.find((l) => l.label === 'Email')
---

<section class="contact">
  <p class="muted">
    Prefer email? Reach out directly at
    <strong class="break-words">{emailLink?.href.replace('mailto:', '')}</strong
    >.
  </p>
</section>
