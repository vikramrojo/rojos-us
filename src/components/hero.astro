---
import cypressLogo from '@/assets/cypress.svg?raw'
import launchdarklyLogo from '@/assets/launchdarkly.svg?raw'
import workosLogo from '@/assets/workos.svg?raw'
---

<section id="hero-section" class="hero">
  <canvas id="hero-canvas" class="hero-canvas"></canvas>
  <div class="hero-body">
    <p class="hero-lede">
      I'm Vikram Rojo (he/him), a designer who pairs product strategy with
      agentic production at high-growth enterprise startups. I use AI to expand
      what gets prototyped and user experience to evaluate what works. Here's my <a
        href="/resume.md"
        class="hero-resume-link">resume.md</a
      >.
    </p>
    <p style="margin-block-end: 0.5rem">Trusted with product design at:</p>
    <div class="hero-logos">
      <div class="logo-invert hero-logo" style="block-size: 1.5rem">
        <Fragment set:html={workosLogo} />
      </div>
      <div class="logo-invert hero-logo" style="block-size: 1.75rem">
        <Fragment set:html={launchdarklyLogo} />
      </div>
      <div class="logo-invert hero-logo" style="block-size: 2.0rem">
        <Fragment set:html={cypressLogo} />
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/textmode.js@latest/dist/textmode.umd.js"
></script>
<script is:inline src="/scripts/sketch.js"></script>
