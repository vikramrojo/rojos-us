---
/**
 * Lucide's `linkedin` mark, vendored. See github.astro for why.
 */
interface Props {
  size?: number | string
  color?: string
  'stroke-width'?: number | string
  class?: string
  [key: string]: unknown
}

const {
  size = 24,
  color = 'currentColor',
  'stroke-width': strokeWidth = 2,
  class: className,
  ...rest
} = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['lucide', 'lucide-linkedin', className]}
  {...rest}
>
  <path
    d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2a2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6M2 9h4v12H2z"
  ></path>
  <circle cx="4" cy="4" r="2"></circle>
</svg>
