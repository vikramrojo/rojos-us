---
import type { IconComponent } from '@/types'
import { ChevronRight, House } from '@lucide/astro'

export interface BreadcrumbItem {
  href?: string
  label: string
  icon?: IconComponent
}

interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props
---

<nav aria-label="breadcrumb">
  <ol class="crumbs">
    <li>
      <a href="/" aria-label="Home"><House class="icon-sm" /></a>
    </li>
    {
      items.map((item, index) => {
        const Icon = item.icon
        const isLast = index === items.length - 1
        return (
          <>
            <li data-crumb-separator aria-hidden="true">
              <ChevronRight />
            </li>
            <li>
              {isLast ? (
                <span aria-current="page">
                  {Icon && <Icon class="icon-sm" />}
                  <span>{item.label}</span>
                </span>
              ) : (
                <a href={item.href}>
                  {Icon && <Icon class="icon-sm" />}
                  <span>{item.label}</span>
                </a>
              )}
            </li>
          </>
        )
      })
    }
  </ol>
</nav>
