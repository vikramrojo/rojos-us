---
import { getCollection, render } from 'astro:content'

const entries = (await getCollection('about')).sort(
  (a, b) => a.data.order - b.data.order,
)

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry)
    return { id: entry.id, title: entry.data.title, Content }
  }),
)
---

<div class="accordion">
  {
    items.map(({ id, title, Content }, i) => (
      <details id={id} open={i === 0 || undefined}>
        <summary>
          {title}
          <span class="chevron">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div class="accordion-body">
          <div>
            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
      </details>
    ))
  }
</div>

<script>
  const accordion = document.querySelector('.about-accordion')
  accordion?.addEventListener('click', (e) => {
    const clicked = (e.target as HTMLElement).closest('details')
    if (!clicked) return
    accordion.querySelectorAll('details[open]').forEach((open) => {
      if (open !== clicked) (open as HTMLDetailsElement).open = false
    })
  })
</script>
