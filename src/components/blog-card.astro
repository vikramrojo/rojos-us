---
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { FileText, Hash } from '@lucide/astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<div class="entry-card">
  <Link href={`/${entry.collection}/${entry.id}`} class="entry-card-layout">
    {
      entry.data.image && (
        <div class="entry-card-media">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
          />
        </div>
      )
    }

    <div class="entry-card-body">
      <h3 class="entry-card-title">{entry.data.title}</h3>
      <p class="entry-card-desc">{entry.data.description}</p>

      <div class="entry-meta">
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="entry-meta-item">
                  <span class="avatar" style="--avatar-size: 1.25rem">
                    {author.avatar && (
                      <img src={author.avatar} alt={author.name} />
                    )}
                    <span>{author.name[0]}</span>
                  </span>
                  <span>{author.name}</span>
                </div>
              ))}
              <span class="rule" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <span class="rule"></span>
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <span class="rule" />
              <span class="entry-meta-item">
                <FileText class="icon-inline" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="entry-tags">
            {entry.data.tags.map((tag) => (
              <span class="badge">
                <Hash class="icon-inline" />
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
