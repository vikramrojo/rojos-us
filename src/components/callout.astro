---
import { cn } from '@/lib/utils'
import {
  Anchor,
  BookOpen,
  Check,
  ChevronDown,
  CircleAlert,
  CircleCheck,
  CircleCheckBig,
  CircleQuestionMark,
  Code,
  Dumbbell,
  FileText,
  GitBranch,
  Info,
  Lightbulb,
  List,
  MessageCircle,
  MessageSquareWarning,
  PenTool,
  Puzzle,
  RotateCcw,
  ShieldAlert,
  SquareCheckBig,
  TriangleAlert,
} from '@lucide/astro'

const calloutConfig = {
  note: {
    icon: Info,
  },
  tip: {
    icon: Lightbulb,
  },
  warning: {
    icon: TriangleAlert,
  },
  danger: {
    icon: ShieldAlert,
  },
  important: {
    icon: MessageSquareWarning,
  },
  definition: {
    icon: BookOpen,
  },
  theorem: {
    icon: CircleCheckBig,
  },
  lemma: {
    icon: Puzzle,
  },
  proof: {
    icon: SquareCheckBig,
  },
  corollary: {
    icon: GitBranch,
  },
  proposition: {
    icon: FileText,
  },
  axiom: {
    icon: Anchor,
  },
  conjecture: {
    icon: CircleQuestionMark,
  },
  notation: {
    icon: PenTool,
  },
  remark: {
    icon: MessageCircle,
  },
  intuition: {
    icon: Lightbulb,
  },
  recall: {
    icon: RotateCcw,
  },
  explanation: {
    icon: CircleQuestionMark,
  },
  example: {
    icon: Code,
  },
  exercise: {
    icon: Dumbbell,
  },
  problem: {
    icon: CircleAlert,
  },
  answer: {
    icon: Check,
  },
  solution: {
    icon: CircleCheck,
  },
  summary: {
    icon: List,
  },
} as const

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

interface Props {
  title?: string
  class?: string
  variant?: keyof typeof calloutConfig
  defaultOpen?: boolean
}

const { title, variant = 'note', defaultOpen = true, ...rest } = Astro.props

const VariantIcon = calloutConfig[variant].icon
---

<details
  class={cn('callout', rest.class)}
  data-callout={variant}
  {...rest}
  open={defaultOpen}
>
  <summary>
    <VariantIcon />
    <span class="callout-label">
      {capitalize(variant)}
      {title && <span class="callout-title"> ({title})</span>}
    </span>
    <ChevronDown />
  </summary>
  <div>
    <slot />
  </div>
</details>
