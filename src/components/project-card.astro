---
import { formatDate } from '@/lib/utils'
import { Calendar } from '@lucide/astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<div class="entry-card">
  <div class="entry-card-layout">
    {
      project.data.image && (
        <div class="entry-card-media">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={1200}
            height={630}
          />
        </div>
      )
    }
    <div class="entry-card-body">
      <h3 class="entry-card-title">
        {project.data.name}
      </h3>
      <p class="entry-card-desc">
        {project.data.description}
      </p>
      {
        project.data.startDate && (
          <p class="entry-meta entry-meta-dim">
            <span class="entry-meta-item">
              <Calendar class="icon-inline" />
              <span>
                {formatDate(project.data.startDate)}
                {project.data.endDate
                  ? ` → ${formatDate(project.data.endDate)}`
                  : ' → Present'}
              </span>
            </span>
          </p>
        )
      }
      {
        project.data.tags && (
          <div class="entry-tags">
            {project.data.tags.map((tag: string) => (
              <span class="badge">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
