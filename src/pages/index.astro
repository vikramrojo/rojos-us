---
import AboutSections from '@/components/about-sections.astro'
import Contact from '@/components/contact.astro'
import Hero from '@/components/hero.astro'
import PageHead from '@/components/page-head.astro'
import PdfViewer from '@/components/pdf-viewer'
import WorkTimeline from '@/components/work-timeline.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout>
  <PageHead slot="head" title="Home" />
  <Hero />
  <div class="section-label" id="about">
    <span>Summary</span>
  </div>
  <AboutSections />
  <div class="section-label" id="portfolio">
    <span>Portfolio</span>
  </div>
  <div class="bleed">
    <div role="tablist" class="tabs">
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Marketing"
        checked="checked"
      />
      <div class="tab-content">
        <PdfViewer
          client:only="react"
          src="/pitch/minka-repositioning-deckset.pdf"
        />
      </div>
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Product"
      />
      <div class="tab-content">
        <PdfViewer
          client:only="react"
          src="/pitch/workos-webhooks-deckset.pdf"
        />
      </div>
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Engineering"
      />
      <div class="tab-content">
        <PdfViewer client:only="react" src="/pitch/wondo-beta-deckset.pdf" />
      </div>
    </div>
  </div>
  <div class="section-label" id="work">
    <span>Experience</span>
  </div>
  <WorkTimeline />
  <div class="section-label" id="contact">
    <span>Contact</span>
  </div>
  <Contact />
</Layout>
