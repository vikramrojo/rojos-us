---
import AboutSections from '@/components/about-sections.astro'
import Contact from '@/components/contact.astro'
import Hero from '@/components/hero.astro'
import PageHead from '@/components/page-head.astro'
import PdfViewer from '@/components/pdf-viewer'
import WorkTimeline from '@/components/work-timeline.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout>
  <PageHead slot="head" title="Home" />
  <Hero />
  <div
    class="text-muted-foreground flex items-center gap-4 text-sm tracking-widest uppercase"
    id="about"
  >
    <span>Summary</span>
    <div class="flex-1 border-t"></div>
  </div>
  <AboutSections />
  <div
    class="text-muted-foreground mt-8 flex items-center gap-4 text-sm tracking-widest uppercase md:mt-20"
    id="portfolio"
  >
    <span>Portfolio</span>
    <div class="flex-1 border-t"></div>
  </div>
  <div class="xl:-mx-48">
    <div role="tablist" class="tabs">
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Marketing"
        checked="checked"
      />
      <div class="tab-content">
        <PdfViewer
          client:only="react"
          src="/pitch/minka-repositioning-deckset.pdf"
        />
      </div>
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Product"
      />
      <div class="tab-content">
        <PdfViewer
          client:only="react"
          src="/pitch/workos-webhooks-deckset.pdf"
        />
      </div>
      <input
        type="radio"
        name="portfolio_tabs"
        class="tab"
        aria-label="Engineering"
      />
      <div class="tab-content">
        <PdfViewer client:only="react" src="/pitch/wondo-beta-deckset.pdf" />
      </div>
    </div>
  </div>
  <div
    class="text-muted-foreground mt-8 flex items-center gap-4 text-sm tracking-widest uppercase md:mt-20"
    id="work"
  >
    <span>Experience</span>
    <div class="flex-1 border-t"></div>
  </div>
  <WorkTimeline />
  <div
    class="text-muted-foreground mt-8 flex items-center gap-4 text-sm tracking-widest uppercase md:mt-20"
    id="contact"
  >
    <span>Contact</span>
    <div class="flex-1 border-t"></div>
  </div>
  <Contact />
</Layout>
