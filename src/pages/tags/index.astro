---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { Hash, Tags } from '@lucide/astro'

const sortedTags = await getSortedTags()
---

<Layout class="measure-md">
  <PageHead slot="head" title="Tags" />
  <Breadcrumbs items={[{ label: 'Tags', icon: Tags }]} />

  <div class="stack">
    <div class="cluster">
      {
        sortedTags.map(({ tag, count }) => (
          <Link href={`/tags/${tag}`} class="badge">
            <Hash class="icon-inline" />
            {tag}
            <span class="muted" style="margin-inline-start: 0.375rem">
              ({count})
            </span>
          </Link>
        ))
      }
    </div>
  </div>
</Layout>
