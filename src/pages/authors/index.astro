---
import AuthorCard from '@/components/author-card.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { getAllAuthors } from '@/lib/data-utils'
import { Users } from '@lucide/astro'

const authors = await getAllAuthors()
---

<Layout class="measure-md">
  <PageHead slot="head" title="Authors" />
  <Breadcrumbs items={[{ label: 'Authors', icon: Users }]} />
  {
    authors.length > 0 ? (
      <ul class="stack">
        {authors.map((author) => (
          <li>
            <AuthorCard author={author} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted centered">No authors found.</p>
    )
  }
</Layout>
