---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { CircleQuestionMark } from '@lucide/astro'
---

<Layout class="measure-md">
  <PageHead slot="head" title="404" />
  <Breadcrumbs items={[{ label: '???', icon: CircleQuestionMark }]} />

  <section class="stack centered" style="--gap: 1rem; align-items: center">
    <div style="max-inline-size: 28rem">
      <h1 class="medium" style="margin-block-end: 1rem">404: Page not found</h1>
      <p class="prose">Oops! The page you're looking for doesn't exist.</p>
    </div>
    <Link href="/" class="btn">
      <span>&larr;</span> Go to home page
    </Link>
  </section>
</Layout>
