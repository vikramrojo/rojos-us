---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Info } from '@lucide/astro'
import { getCollection, render } from 'astro:content'

const sections = (await getCollection('about')).sort(
  (a, b) => a.data.order - b.data.order,
)

const rendered = await Promise.all(
  sections.map(async (section) => {
    const { Content } = await render(section)
    return { section, Content }
  }),
)
---

<Layout class="measure-md">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: Info }]} />

  <div class="stack" style="--gap: 2.5rem">
    {
      rendered.map(({ section, Content }) => (
        <section>
          <h2 class="medium" style="margin-block-end: 0.75rem">
            {section.data.title}
          </h2>
          <div class="prose post-prose">
            <Content />
          </div>
        </section>
      ))
    }
  </div>
</Layout>
