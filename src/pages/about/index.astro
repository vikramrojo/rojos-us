---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { getCollection, render } from 'astro:content'

const sections = (await getCollection('about')).sort(
  (a, b) => a.data.order - b.data.order,
)

const rendered = await Promise.all(
  sections.map(async (section) => {
    const { Content } = await render(section)
    return { section, Content }
  }),
)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <div class="flex flex-col gap-y-10">
    {
      rendered.map(({ section, Content }) => (
        <section>
          <h2 class="mb-3 font-medium">{section.data.title}</h2>
          <div class="prose max-w-none">
            <Content />
          </div>
        </section>
      ))
    }
  </div>
</Layout>
