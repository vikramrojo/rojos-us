{
  "name": "astro-erudite",
  "type": "module",
  "version": "1.6.3",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write **/*.{ts,tsx,css,astro} --ignore-path .gitignore",
    "verify": "largen verify src/styles/components/*.css"
  },
  "dependencies": {
    "@astrojs/check": "0.9.7",
    "@astrojs/markdown-remark": "7.0.0",
    "@astrojs/mdx": "5.0.0",
    "@astrojs/react": "5.0.0",
    "@astrojs/rss": "4.0.17",
    "@astrojs/sitemap": "3.7.1",
    "@expressive-code/plugin-collapsible-sections": "^0.40.2",
    "@expressive-code/plugin-line-numbers": "^0.40.2",
    "@lucide/astro": "^1.33.0",
    "@shikijs/rehype": "^3.4.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "astro": "6.0.2",
    "largen": "^0.3.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-pdf": "^10.4.1",
    "rehype-expressive-code": "^0.40.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-emoji": "^5.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.11",
    "wrangler": "^4.95.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
